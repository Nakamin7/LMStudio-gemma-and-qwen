# Copy this file to .env. NEVER upload .env to GitHub.
# Inference defaults to LM Studio until you select another provider in the UI.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Optional fallback loaded instance ID; normally leave empty.
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=lm-studio
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_SECONDS=180

# Optional cloud inference; configure API keys only for the providers you use.
# A ChatGPT web subscription does NOT include OpenAI API billing.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Jev relevance filtering (disabled by default in the UI).
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_RELEVANCE_THRESHOLD=0.80

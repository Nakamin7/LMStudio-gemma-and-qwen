# Copy to .env; never commit .env
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Set to exact loaded model ID from GET /v1/models, or leave blank if only one model is listed.
LM_STUDIO_MODEL=
# Placeholder for a local server without authentication; change if authentication is enabled.
LM_STUDIO_API_KEY=lm-studio
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_SECONDS=180
